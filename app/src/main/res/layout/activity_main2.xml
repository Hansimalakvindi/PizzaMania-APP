<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="246dp"
        android:layout_height="230dp"
        app:srcCompat="@drawable/logo12345678"
        tools:layout_editor_absoluteX="82dp"
        tools:layout_editor_absoluteY="3dp" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="458dp"
        android:layout_height="141dp"
        android:fontFamily="sans-serif-medium"
        android:text="Welcome to PIZZA MANIA"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="-24dp"
        tools:layout_editor_absoluteY="216dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="pizza handcrafted & always delicious"
        android:textAlignment="center"
        android:textSize="16sp"
        tools:layout_editor_absoluteX="74dp"
        tools:layout_editor_absoluteY="252dp" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="76dp"
        android:layout_height="34dp"
        android:fontFamily="serif"
        android:text="Email"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="18dp"
        tools:layout_editor_absoluteY="309dp" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="110dp"
        android:layout_height="39dp"
        android:fontFamily="serif"
        android:text="Password"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="397dp" />

    <EditText
        android:id="@+id/editTextTextEmailAddress"
        android:layout_width="377dp"
        android:layout_height="47dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="331dp" />

    <EditText
        android:id="@+id/editTextTextPassword"
        android:layout_width="372dp"
        android:layout_height="43dp"
        android:ems="10"
        android:inputType="textPassword"
        tools:layout_editor_absoluteX="18dp"
        tools:layout_editor_absoluteY="414dp" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remember me"
        tools:layout_editor_absoluteX="20dp"
        tools:layout_editor_absoluteY="464dp" />

    <Button
        android:id="@+id/button2"
        android:layout_width="185dp"
        android:layout_height="43dp"
        android:backgroundTint="#DD2C00"
        android:text="Fogot Password"
        android:textColor="#FFFFFF"
        android:textColorLink="#FFFFFF"
        tools:layout_editor_absoluteX="205dp"
        tools:layout_editor_absoluteY="464dp" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="188dp"
        android:layout_height="28dp"
        android:fontFamily="sans-serif"
        android:text="Already Have An Account?"
        tools:layout_editor_absoluteX="82dp"
        tools:layout_editor_absoluteY="571dp" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:textColor="#DD2C00"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="257dp"
        tools:layout_editor_absoluteY="571dp" />

</androidx.constraintlayout.widget.ConstraintLayout>